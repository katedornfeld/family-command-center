# Copy this file to .env.local (same folder as package.json) and fill in
# the real values from your Supabase project. Never commit .env.local.
#
# Where to find these: Supabase Dashboard → your project → Project Settings
# → API.

# "Project URL" on that page. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key on that page (NOT the service_role key).
# Safe to expose to the browser — Row Level Security policies control what
# it can actually access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Elevated Supabase access for server-only routes (Claude meal-plan
# generation, the weather cron job) that need to bypass RLS. Find it on the
# same Project Settings → API page, labeled "service_role" — NEVER expose
# this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates calls to the Claude API from the meal-plan generation route.
# Get one at https://console.anthropic.com/settings/keys — server-only,
# never exposed to the browser.
ANTHROPIC_API_KEY=

# Not needed yet — will be added with the daily weather cron job:
# WEATHER_API_KEY=
# CRON_SECRET=
